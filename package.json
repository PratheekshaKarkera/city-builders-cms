{
  "name": "payload-cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "lint": "next lint",
    "payload": "payload",
    "start": "node -r dotenv/config ./node_modules/next/dist/bin/next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" npx playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "prepare": "husky",
    "prettier": "prettier --write \"*/.{js,vue,scss,html}\"",
    "gitleaks": "gitleaks protect --source . --staged --verbose",
    "semgrep": "semgrep --config=auto .",
    "trivy": "trivy fs . --severity HIGH,CRITICAL",
    "cspell": "cspell \"{src,tests}/**/*.{ts,tsx,mts}\" --cache --no-must-find-files"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.79.1",
    "@payloadcms/email-resend": "3.79.1",
    "@payloadcms/next": "3.79.1",
    "@payloadcms/plugin-cloud-storage": "3.79.1",
    "@payloadcms/richtext-lexical": "3.79.1",
    "@payloadcms/storage-s3": "3.79.1",
    "@payloadcms/ui": "3.79.1",
    "@rumess/payload-audit-log": "^1.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.10.0",
    "next": "15.5.15",
    "payload": "3.79.1",
    "payload-oapi": "^0.2.5",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "resend": "^6.9.2",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.5.4",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "4.5.2",
    "cspell": "^9.7.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.7",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "prettier": "^3.4.2",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "overrides": {
    "mongoose": "8.22.1",
    "fast-xml-parser": "5.5.9",
    "undici": "7.24.5",
    "lodash": "4.18.0",
    "picomatch": "4.0.4"
  }
}
